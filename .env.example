# Copy to .env and fill in. NEXT_PUBLIC_* values are inlined at build time,
# so they must be set wherever `next build` runs (the server, for Docker builds).

# ---- App ----
APP_URL=http://localhost:3000
DATABASE_URL=postgres://localhost:5432/stem_racing

# ---- Tests: each test file creates and drops its own database through this admin connection ----
TEST_DATABASE_ADMIN_URL=postgres://localhost:5432/postgres

# ---- Staff sign-in (Better Auth) ----
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000

# ---- Cloudflare Turnstile ----
# These are Cloudflare's public TEST keys (always pass). Replace with real keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- SMTP for Event Pass emails (Gmail / Google Workspace) ----
# Leave SMTP_USER empty to skip sending. EMAIL_FROM must be a verified alias of SMTP_USER,
# otherwise Gmail rewrites the From address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Organisers' contact channels (each is hidden when empty) ----
# LINE accepts an OA id such as @stemracingth or a full https:// link.
NEXT_PUBLIC_CONTACT_LINE=
NEXT_PUBLIC_CONTACT_PHONE=

# ---- Docker Compose (server only; see docs/deploy.md) ----
# Password of the `db` container's Postgres user. Compose builds the app's DATABASE_URL from it
# (postgres://stem_racing:<password>@db:5432/stem_racing), overriding DATABASE_URL above.
# Use URL-safe characters: openssl rand -hex 32. Only applied when the database volume is first created.
POSTGRES_PASSWORD=
