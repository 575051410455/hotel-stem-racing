# Reverse proxy for the Next.js app. Visitors reach it only through the Cloudflare Tunnel
# (ADR 0005): Cloudflare's edge → cloudflared (Compose service) → nginx :80 → app :3000.
# No port is published on the host, and TLS ends at Cloudflare's edge.
# A template: at start the nginx image fills in CLOUDFLARED_IP (set in docker-compose.yml) and
# writes the result to /etc/nginx/conf.d/default.conf, which its nginx.conf includes inside http {}.

server_tokens off;

# Docker's embedded DNS. With `resolve` below, nginx follows the app container's address when
# `docker compose up -d --build` recreates it, instead of keeping a stale IP until restarted.
# valid=1s: a recreated app often gets a new address, and requests sent to the old one hang until
# the name is looked up again, so look it up every second.
resolver 127.0.0.11 valid=1s ipv6=off;

upstream app {
    zone app_upstream 64k;
    # max_fails=0: never mark the only app server as down. By default one refused connection while
    # a deploy restarts the app makes nginx answer 502 for the next 10 s without trying it again.
    server app:3000 resolve max_fails=0;
}

# Restore the visitor's IP from Cloudflare's CF-Connecting-IP header (ngx_http_realip_module).
# Cloudflare's edge sets the header, and it is trusted only from cloudflared's fixed address on the
# `tunnel` network (x-cloudflared-ip in docker-compose.yml): from any other peer it is ignored and
# $remote_addr stays that peer.
set_real_ip_from ${CLOUDFLARED_IP};
real_ip_header CF-Connecting-IP;

# $remote_addr is the visitor; $realip_remote_addr is cloudflared, which connected to us.
log_format tunnel '$remote_addr via $realip_remote_addr [$time_local] "$request" '
                  '$status $body_bytes_sent ${request_time}s "$http_referer" '
                  '"$http_user_agent" cf_ray=$http_cf_ray';

server {
    listen 80 default_server;
    server_name _;
    access_log /var/log/nginx/access.log tunnel;

    # Cloudflare's "Always Use HTTPS" redirects plain HTTP at the edge. If that setting is off, an
    # http:// visit still comes through the tunnel, marked by Cloudflare's X-Forwarded-Proto.
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }

    location / {
        proxy_pass http://app;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto https;
        # The visitor's IP for the app (rate limiting reads X-Real-IP). Both headers are set to
        # the single restored address, never appended to, so a client can't inject a value.
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        # Don't pass Cloudflare's raw client-IP headers on to the app. An empty value removes the
        # header.
        proxy_set_header CF-Connecting-IP  "";
        proxy_set_header True-Client-IP    "";

        # Bulk email sends one batch per request; allow up to 300s. Cloudflare itself ends
        # requests at 100s (error 524) on non-Enterprise plans, so each batch must finish sooner.
        proxy_connect_timeout 10s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;

        # Stream responses (Suspense, Partial Prerendering) instead of buffering whole pages.
        proxy_buffering off;
    }
}
